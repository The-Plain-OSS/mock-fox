{
  "name": "mock-fox",
  "version": "1.0.0",
  "description": "Mock Fox desktop app",
  "author": "Woojin Kim",
  "type": "module",
  "main": "electron-main.js",
  "build": {
    "compression": "store",
    "files": [
      "electron-main.js",
      "preload.cjs",
      "index.html",
      "description.html",
      "assets/**",
      "js/**"
    ],
    "mac": {
      "target": ["pkg"],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "extraResources": [
        { "from": "resources/darwin-amd64", "to": "resources/darwin-amd64" },
        { "from": "resources/darwin-arm64", "to": "resources/darwin-arm64" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "signExts": [],
      "extraResources": [
        { "from": "resources/windows-amd64", "to": "resources/windows-amd64" }
      ]

    }
  },
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac pkg",
    "build:win": "electron-builder --win portable --x64",
    "build:win:release": "electron-builder --win --x64 --publish=never",
    "build:mac:x64": "electron-builder --mac pkg --x64",
    "build:mac:arm64": "electron-builder --mac pkg --arm64",
    "release": "electron-builder --win portable --publish=always"
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  }
}